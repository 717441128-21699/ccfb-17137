{
  "name": "zhuxiang-raft-game",
  "version": "1.0.0",
  "description": "竹乡景区放竹排互动小游戏",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check:sim": "esbuild scripts/check-sim.ts --bundle --platform=node --format=esm --outfile=node_modules/check-sim.mjs && node node_modules/check-sim.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
